
# ======================================================
# 🧠 Golem Brain (Web Gemini 大腦設定)
# ======================================================
# Google Gemini API Keys (必填)
# 說明：用於 DOM Doctor 自癒功能與與某些對話分析。
# 取得：https://aistudio.google.com/app/apikey
# 技巧：支援多組 Key 輪替 (KeyChain)，請用半形逗號 "," 分隔。

GEMINI_API_KEYS=YOUR_GEMINI_API_KEY_HERE

# ======================================================
# ✈️ Telegram 設定 (左頭)
# ======================================================
# Telegram Bot Token
# 取得：在 Telegram 搜尋 @BotFather 申請

TELEGRAM_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Telegram Admin ID (管理員白名單)
# 說明：只有此 ID 可以執行 /patch 或高風險指令。
# 取得：在 Telegram 搜尋 @userinfobot，查看 "Id" 欄位。

ADMIN_ID=YOUR_TELEGRAM_USER_ID

# ======================================================
# 👾 Discord 設定 (右頭)
# ======================================================
# Discord Bot Token
# 取得：Discord Developer Portal -> Bot -> Reset Token
# 注意：請確保已開啟 "Message Content Intent"

# DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# Discord Admin ID (管理員白名單)
# 說明：只有此 ID 可以執行 /patch 或高風險指令。
# 取得：Discord 設定 -> 進階 -> 開啟「開發者模式」，
#       然後對自己的頭像點右鍵 -> 複製使用者 ID。

# DISCORD_ADMIN_ID=YOUR_DISCORD_USER_ID

# ======================================================
# ⚙️ System Config (系統進階設定)
# ======================================================
# 瀏覽器資料暫存路徑
# 說明：存放 Puppeteer 的 Login Session，重啟後不用重新登入 Google。
# 預設：./golem_memory

USER_DATA_DIR=./golem_memory

# 測試模式 (通常設為 false)
# true: 只測試程式碼是否能執行，不啟動瀏覽器。
# false: 正常啟動。

GOLEM_TEST_MODE=false

# ======================================================
# 🧠 Memory Engine (記憶引擎設定) 
# ======================================================
# 選擇模式：
# browser - (預設) 使用內建 memory.html，無須安裝額外軟體。
# qmd     - (進階) 使用 qmd 混合搜尋，需安裝 Bun 與 qmd。
# (進階選用) 指定 qmd 執行檔路徑，若已加入系統 PATH 則留空即可
# GOLEM_QMD_PATH=/path/to/your/qmd

GOLEM_MEMORY_MODE=browser

# ======================================================
# ☁️ OTA Update Config (空中升級設定)
# ======================================================
# 指定 /update 指令抓取原始碼的 GitHub 儲存庫
# 預設若留空則使用：https://raw.githubusercontent.com/Arvincreator/project-golem/main/

GITHUB_REPO=

# ======================================================
# 🧠 Multi-Brain Architecture (多重腦部設定)
# ======================================================
# 定義 AI 模型的優先順序 (Fallback Chain)
# 選項: web/gemini, web/chatgpt, ollama
# 範例: 先嘗試 Web Gemini，失敗則轉 Web ChatGPT，再失敗轉 Ollama
BRAIN_SEQUENCE=web/gemini,web/chatgpt,ollama

# 瀏覽器模式
# new = 背景執行 (Headless), false = 顯示視窗 (Debug)
GOLEM_HEADLESS=new

# ======================================================
# 🦙 Ollama Local AI (本機模型設定)
# ======================================================
# Ollama 服務位址 (預設 localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# 使用的模型名稱 (需先在 ollama pull 下載)
# 推薦: llama3, mistral, gemma
OLLAMA_MODEL=llama3
